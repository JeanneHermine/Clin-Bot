# Example environment variables for ClinBot
DATABASE_URL=postgresql://pwm_user:pwm_pass@localhost:5432/pwm_db
SECRET_KEY=changeme
FERNET_KEY=change_this_to_a_32_byte_urlsafe_base64

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_ENABLED=true
TWILIO_SANDBOX_AUTO_REGISTER=true

# OTP and server settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_DEBUG_RETURN_CODE=false
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-cloudflare-tunnel-subdomain.trycloudflare.com


# Cloudinary credentials (optional - falls back to local disk storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

